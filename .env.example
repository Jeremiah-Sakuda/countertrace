# Private local configuration. No credentials are committed.
# Only the control service (`countertrace serve`, `countertrace model-check`) reads
# this file; exported environment variables take precedence. Verifier containers
# never receive any of these values.

# Nebius Token Factory (OpenAI-compatible). Confirm the endpoint and the exact
# NVIDIA Nemotron model IDs available to your account before relying on them.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL_ID=
# Optional: a different model for repair proposals (defaults to NEBIUS_MODEL_ID).
NEBIUS_REPAIR_MODEL_ID=
# Optional: a faster tier for interactive interpretation and check proposals,
# e.g. a Nemotron 3 Super ID from your catalog (defaults to NEBIUS_MODEL_ID).
# The ledger prices every call at the prices below, which overestimates a cheaper tier.
NEBIUS_FAST_MODEL_ID=

# Required before any model call. Blank means unconfigured, never unlimited.
COUNTERTRACE_MODEL_INPUT_TOKEN_LIMIT=
COUNTERTRACE_MODEL_OUTPUT_TOKEN_LIMIT=
# The inference ledger blocks new calls after this threshold when both prices
# are set. It is not a hard account/VM spending cap; in-flight calls can exceed it.
# Without prices, cost is reported as unavailable, never as zero.
COUNTERTRACE_DEPLOYMENT_SPEND_LIMIT_USD=
COUNTERTRACE_MODEL_PRICE_INPUT_PER_MTOK_USD=
COUNTERTRACE_MODEL_PRICE_OUTPUT_PER_MTOK_USD=
# Optional model-specific system prefix. Leave blank unless the selected
# endpoint documents a directive. "detailed thinking off" is not universal.
COUNTERTRACE_MODEL_SYSTEM_PREFIX=
COUNTERTRACE_MODEL_TIMEOUT_S=120

COUNTERTRACE_DATA_DIR=.countertrace
# Local test build only: allows owner-supplied RTL and edited repair candidates.
COUNTERTRACE_PUBLIC_UPLOADS_ENABLED=false
