[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 24
prove: mode prove
cover: mode cover
cover: depth 24
timeout 120

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc yices

[script]
read -formal -D CT_DUT=fifo dut.v
read -formal -D CT_DUT=fifo ct_formal_top.sv
chparam -set DEPTH 4 -set WIDTH 8 ct_formal_top
prep -top ct_formal_top

[files]
dut.v
ct_formal_top.sv
