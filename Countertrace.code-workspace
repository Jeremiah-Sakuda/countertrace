{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.egg-info": true
    },
    "search.exclude": {
      "**/.venv": true,
      "**/node_modules": true,
      "**/.countertrace": true,
      "**/evaluation/holdout": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Setup workspace",
        "type": "shell",
        "command": "make setup",
        "problemMatcher": []
      },
      {
        "label": "Check",
        "type": "shell",
        "command": "make check",
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "Integration tests (Docker)",
        "type": "shell",
        "command": "make test-integration",
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "Build verifier image",
        "type": "shell",
        "command": "make image",
        "problemMatcher": []
      },
      {
        "label": "Serve",
        "type": "shell",
        "command": "make serve",
        "problemMatcher": []
      },
      {
        "label": "Environment diagnostic",
        "type": "shell",
        "command": "make doctor",
        "problemMatcher": []
      }
    ]
  }
}
