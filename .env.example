# Private local configuration. No credentials are committed.
# The scaffold reports environment presence only; it does not load this file.
# Export values in the control-service process when inference is implemented.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL_ID=

# Set these after measuring the selected endpoint and operating budget.
# Blank means unconfigured, never unlimited or zero cost.
COUNTERTRACE_MODEL_INPUT_TOKEN_LIMIT=
COUNTERTRACE_MODEL_OUTPUT_TOKEN_LIMIT=
COUNTERTRACE_DEPLOYMENT_SPEND_LIMIT_USD=

COUNTERTRACE_DATA_DIR=.countertrace
COUNTERTRACE_PUBLIC_UPLOADS_ENABLED=false
