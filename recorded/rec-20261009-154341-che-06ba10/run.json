  "inputs": {
   "rst": 1,
   "wr_en": 1,
   "rd_en": 1,
   "din": "WIDTH"
  },
  "outputs": {
   "dout": "WIDTH",
   "full": 1,
   "empty": 1
  },
  "spec": "A synchronous first-in first-out queue holding up to DEPTH words of WIDTH bits, with one rising-edge clock clk.\nrst is a synchronous active-high reset: at a rising edge with rst high the queue becomes empty, and read and write requests at that edge are ignored.\nAt each rising edge without reset: a write (wr_en high) stores din at the tail unless the queue is full; a read (rd_en high) removes the head word unless the queue is empty. Full and empty are judged from the occupancy before the edge, so a read and a write at the same edge are each accepted or ignored on that basis.\nAfter an accepted read, dout contains the removed word after that edge. Its value is unconstrained at other times, including reset, idle cycles and ignored reads. Do not require it to remain stable between accepted reads.\nempty is high exactly when the queue holds no words; full is high exactly when it holds DEPTH words. Words come out in the order they were accepted.",
  "split": "development"
 },
 "max_rounds": 4,
 "state": "complete",
